# 이 파일을 .env로 복사하고 발급받은 키를 서버에만 설정하세요.
PORT=3000
HOST=127.0.0.1
DATA_GO_KR_SERVICE_KEY=
# 국세청 키를 별도로 발급한 경우 설정. 비어 있으면 DATA_GO_KR_SERVICE_KEY 사용.
NTS_SERVICE_KEY=
KOSIS_API_KEY=
KAKAO_REST_API_KEY=
# 선택: 서울 열린데이터광장 상권 추정매출(카드사 가맹점 기반 VwsmTrdarSelngQq) 인증키 (무료 발급: https://data.seoul.go.kr/)
SEOUL_DATA_API_KEY=
# 선택: 카카오 소셜 로그인 및 멀티 플랫폼/비즈니스 채널 설정 (서버 전용)
KAKAO_CLIENT_SECRET=
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=
KAKAO_BIZ_SECRET=
# 24자 이상 무작위 토큰. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=
# KOSIS URL 생성 도구에서 선택한 표와 분류를 JSON으로 지정.
# 기업생멸 예시(국가데이터처 산업별 신생기업 생존율): {"orgId":"101","tblId":"DT_2BD1103","objL1":"ALL","itmId":"ALL","prdSe":"Y","newEstPrdCnt":"1"}
# 지역인구 예시(행정구역 시군구별 성별 인구수): {"orgId":"101","tblId":"DT_1B040A3","objL1":"ALL","itmId":"ALL","prdSe":"M","newEstPrdCnt":"1"}
KOSIS_SURVIVAL_QUERY=
KOSIS_REGION_QUERY=
# 회원 데이터베이스 경로. 기본값: .runtime/accounts.sqlite (영속 디스크 필요)
# ACCOUNTS_DB=/data/accounts.sqlite
# HTTPS 서비스 배포 시 production으로 설정 (Secure 로그인 쿠키)
# NODE_ENV=production
