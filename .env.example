# 이 파일을 .env로 복사하고 발급받은 키를 서버에만 설정하세요.
PORT=3000
HOST=127.0.0.1
DATA_GO_KR_SERVICE_KEY=
# 국세청 키를 별도로 발급한 경우 설정. 비어 있으면 DATA_GO_KR_SERVICE_KEY 사용.
NTS_SERVICE_KEY=
KOSIS_API_KEY=
KAKAO_REST_API_KEY=
# 24자 이상 무작위 토큰. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=
# KOSIS URL 생성 도구에서 선택한 표와 분류를 JSON으로 지정 (임의 기본 표 없음).
# 예시 형식: {"orgId":"기관ID","tblId":"통계표ID","objL1":"분류코드","itmId":"항목코드","prdSe":"Y","newEstPrdCnt":"1"}
KOSIS_SURVIVAL_QUERY=
KOSIS_REGION_QUERY=
