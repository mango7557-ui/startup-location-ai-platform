# ============================================================================
# 창업입지 AI - 서버 환경변수 설정 예시 (.env.example)
# 주의: 실제 인증키는 절대 프런트엔드에 노출하지 말고 서버 환경변수로만 관리하세요.
# ============================================================================

PORT=3000
NODE_ENV=development

# 1. PostgreSQL + PostGIS 데이터베이스 연결 정보
DATABASE_URL=postgresql://postgres:password@localhost:5432/startup_location_ai
DB_USE_IN_MEMORY_FALLBACK=true

# 2. 공공데이터포털 (data.go.kr) 서비스키
# - 소상공인시장진흥공단_상가(상권)정보 API (https://www.data.go.kr/data/15012005/openapi.do)
# - 국세청_사업자등록정보 진위확인 및 상태조회 API (https://www.data.go.kr/data/15081808/openapi.do)
DATA_GO_KR_SERVICE_KEY=YOUR_DATA_GO_KR_ENCODED_KEY

# 3. 통계청 KOSIS 국가통계포털 OpenAPI 인증키
# - 기업생멸행정통계 (활동·신생·소멸 및 1·3·5년 생존율), 인구·가구·사업체 통계 (https://kosis.kr/openapi/)
KOSIS_API_KEY=YOUR_KOSIS_API_KEY

# 4. 지도 API 키 (선택: 기본 지도는 OpenStreetMap/Leaflet으로 즉시 작동하며, 카카오/네이버 전환 지원)
KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY
KAKAO_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID
NAVER_MAP_CLIENT_SECRET=YOUR_NAVER_MAP_CLIENT_SECRET

# 5. 관리자 API 보호용 토큰
ADMIN_API_TOKEN=dev-admin-token-change-in-production
